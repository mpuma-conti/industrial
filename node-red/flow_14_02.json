        "func": "let texto = msg.payload;\nlet fecha = new Date().toLocaleString(\"es-PE\");\n\nlet mensaje =\n`*Tensión de subestación*\n${texto} V\n📅 ${fecha}`;\n\nmsg.payload = {\n    type: \"message\",\n    content: mensaje,\n    chatId: \"-XXXXXXXXXXX\", //id de grupo de telegram\n    options: {\n        parse_mode: \"Markdown\"\n    }\n};\n\nreturn msg;",
