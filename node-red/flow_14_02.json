                        "id": "bf266622de6dda80",
                        "port": 0
                    }
                ]
            }
        ],
        "env": [
            {
                "name": "min",
                "type": "num",
                "value": "10"
            },
            {
                "name": "max",
                "type": "num",
                "value": "90"
            },
            {
                "name": "msg_alarm",
                "type": "str",
                "value": "⚠️ Fuera de rango"
            },
            {
                "name": "msg_normal",
                "type": "str",
                "value": "✅ Normalizado"
            }
        ],
        "meta": {},
        "color": "#DDAA99"
