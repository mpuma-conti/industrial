    {
        "id": "bf266622de6dda80",
        "type": "function",
        "z": "1c4a6ecf14ab2dd6",
        "name": "function 5",
        "func": "// Valor actual\nlet valor = msg.payload;\n\n// Parámetros del subflow\nconst MIN = Number(env.get(\"min\"));\nconst MAX = Number(env.get(\"max\"));\nconst MSG_ALARMA = env.get(\"msg_alarm\");\nconst MSG_NORMAL = env.get(\"msg_normal\");\n\n// Estado previo\nlet estado = context.get(\"estado\") || \"normal\";\n\nlet nuevoEstado = estado;\nlet mensaje = null;\n\n// Evaluación\nif (valor < MIN || valor > MAX) {\n\n    if (estado === \"normal\") {\n        nuevoEstado = \"alarma\";\n        mensaje = `${MSG_ALARMA}: ${valor}`;\n    }\n\n} else {\n\n    if (estado === \"alarma\") {\n        nuevoEstado = \"normal\";\n        mensaje = `${MSG_NORMAL}: ${valor}`;\n    }\n}\n\n// Guardar estado\ncontext.set(\"estado\", nuevoEstado);\n\n// Enviar solo si hay mensaje\nif (mensaje) {\n    msg.payload = mensaje;\n    return msg;\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 240,
        "y": 40,
        "wires": [
            []
        ]
    },
